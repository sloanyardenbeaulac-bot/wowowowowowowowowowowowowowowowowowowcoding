shadow type="positionPicker" id="c!ZkRY.8heSS:i)*%^nQ"><field name="index">84</field></shadow></value><value name="y"><shadow type="positionPicker" id="sID~goSc+(nb`iq^J8MR"><field name="index">25</field></shadow></value><next><block type="device_pause" id="7R3FYa[8Nk$aZvTUJ~:n"><value name="pause"><shadow type="timePicker" id="Xn6k[9BCjcA]I|`=.Edf"><field name="ms">7000</field></shadow></value><next><block type="spritesaytext" id="-eu!KkyT2Vj98FvxhR*a"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><value name="this"><block type="variables_get" id="63:vv-$Rll#lF+2wpls6"><field name="VAR" id="Uv;.qZ[.TS=RsZ?R,J|f">hand</field></block></value><value name="text"><shadow type="text" id="UsQ2buY[-|=ud~8ha$B0"><field name="TEXT">Then, relax muscles until hand is touching top of dog</field></shadow></value><value name="timeOnScreen"><shadow type="timePicker" id="B4^PuAtb,)*c9gC5eMQz"><field name="ms">5000</field></shadow></value><value name="animated"><shadow type="logic_boolean" id="#k2GZ(|H.{p6dGgU2x^F"><field name="BOOL">TRUE</field></shadow></value><next><block type="spritesetpos" id=")Seqn)0{Bd+F^*~sU}S;"><value name="sprite"><block type="variables_get" id="-Z{Nb0uB^N%_7bftcg*f"><field name="VAR" id="Uv;.qZ[.TS=RsZ?R,J|f">hand</field></block></value><value name="x"><shadow type="positionPicker" id=",H!mj.0DOD_:~){]t7ap"><field name="index">84</field></shadow></value><value name="y"><shadow type="positionPicker" id="J8RX!`Vro1+}iG]M0,Ox"><field name="index">35</field></shadow></value><next><block type="device_pause" id="JlPb9pRFhzM9D:70iO?g"><value name="pause"><shadow type="timePicker" id="%_lEH@brdp?[L?}t*3=C"><field name="ms">7000</field></shadow></value><next><block type="spritesaytext" id="`lD*0Mq}U1W]B[B!`29P"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><value name="this"><block type="variables_get" id="jygN#id}9R){kD-%t.]D"><field name="VAR" id="Uv;.qZ[.TS=RsZ?R,J|f">hand</field></block></value><value name="text"><shadow type="text" id="!(xGy~rTRn^`qriXwQ:{"><field name="TEXT">Finally, move hand slowly back and forth 2 inches on top of dog.</field></shadow></value><value name="timeOnScreen"><shadow type="timePicker" id="wLRX}k8#_;mBRsW6a({A"><field name="ms">5000</field></shadow></value><value name="animated"><shadow type="logic_boolean" id="9tI6-n!_*^1qwP]^{=u~"><field name="BOOL">TRUE</field></shadow></value><next><block type="startEffectOnSprite" id="M!?su|VBJeNEeyfsN-OM"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><field name="effect">effects.confetti</field><value name="sprite"><block type="variables_get" id="9KAgf`AC?!=]?4%@,]IR"><field name="VAR" id="/.e?a87G0:_W1Auu_r9i">Aerow</field></block></value><value name="duration"><shadow type="timePicker" id="gA#PC|RL_C?eYkRvLqMB"><field name="ms">500</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="pxt-on-start" id="{]a!J:t((K8_KQOq%AO4" x="20" y="28"><statement name="HANDLER"><block type="gamesetbackgroundimage" id="7zV8;(ifa`Be9DQ3p.zG"><value name="img"><shadow type="background_image_picker" id="(Mdb0*T8vK~3DkMGWMgi"><field name="img">img`
